<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace = "com.project.postllmservice.mapper.PostMapper">
    <insert id="addPost">
        INSERT INTO post (
            post_name,
            post_content,
            user_id
        )
        VALUES (
            #{postName},
            #{postContent},
            #{userId}
        )
    </insert>
</mapper>