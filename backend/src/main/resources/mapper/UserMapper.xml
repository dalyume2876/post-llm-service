<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace = "com.project.postllmservice.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.project.postllmservice.entity.User">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="nickname" column="nickname"/>
        <result property="profile" column="profile"/>
    </resultMap>

    <insert id="addUser">
        insert into 
            user(user_id, password, nickname, email, profile)
        values
            (#{userId}, #{password}, #{nickname}, #{email}, #{profile});
    </insert>

    <select id="findById" resultMap="userResultMap">
        select
            id,
            user_id,
            nickname,
            email
        from user
        where id = #{id};
    </select>

    <select id="findByEmail" resultMap="userResultMap">
        select
            id,
            user_id,
            nickname,
            email
        from user
        where email = #{email};
    </select>

</mapper>